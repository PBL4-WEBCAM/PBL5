        color: var(--primary-color);
    }

    .meaning {
        flex-grow: 1;
        margin-left: 10px;
        color: var(--text-color);
    }

    /* Modal styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background-color: white;
        border-radius: 10px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        border-bottom: 1px solid var(--border-color);
    }

    .modal-header h3 {
        margin: 0;
        color: var(--primary-color);
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: var(--light-text);
    }

    .close-btn:hover {
        color: var(--text-color);
    }

    .modal-body {
        padding: 20px;
    }

    .object-detail {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
    }

    .object-detail img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 8px;
    }

    .detail-info h4 {
        margin-top: 0;
        color: var(--primary-color);
    }

    .vocabulary-actions {
