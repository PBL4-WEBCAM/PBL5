        height: 100%;
        object-fit: cover;
    }

    .object-info {
        padding: 10px;
    }

    .object-info h4 {
        margin: 0 0 5px 0;
        color: var(--primary-color);
    }

    .confidence {
        font-size: 0.8rem;
        color: var(--light-text);
        margin: 0 0 5px 0;
    }

    .vocabulary {
